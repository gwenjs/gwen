{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "rules": {
    "no-unused-vars": "error",
    "no-var": "error",
    "prefer-const": "error",
    "eqeqeq": "error",
    "no-console": "warn",
    "no-restricted-imports": [
      "error",
      {
        "patterns": ["*/wasm/gwen_core*", "*/wasm/gwen-core*", "gwen_core", "gwen-core"]
      }
    ]
  },
  "env": {
    "browser": true,
    "node": true
  },
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "**/*.d.ts",
    "crate/**",
    "**/wasm/**"
  ],
  "overrides": [
    {
      "files": ["packages/schema/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "*/wasm/gwen_core*",
              "*/wasm/gwen-core*",
              "gwen_core",
              "gwen-core",
              "@gwenjs/core*",
              "@gwenjs/kit*",
              "@gwenjs/app*",
              "@gwenjs/vite*",
              "@gwenjs/math*",
              "@gwenjs/physics*",
              "@gwenjs/renderer-core*",
              "@gwenjs/camera-core*"
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/core/src/engine/gwen-engine.ts",
        "packages/core/src/engine/engine-loop.ts",
        "packages/core/src/engine/engine-collaborators.ts"
      ],
      "rules": {
        "max-lines": ["error", { "max": 400, "skipBlankLines": true, "skipComments": true }]
      }
    }
  ]
}
