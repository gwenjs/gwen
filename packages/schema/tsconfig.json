{
  "compilerOptions": {
    "composite": true,
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": ".",
    "outDir": "dist",
    "lib": ["ES2022", "esnext.disposable"],
    "customConditions": ["development"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"],
  "extends": "../../tsconfig.base.json",
  "references": []
}
