{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2022", "DOM", "esnext.disposable"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleResolution": "bundler",
    "noEmit": true,
    "types": ["vitest/globals", "node"]
  },
  "include": ["src", "tests", "bench/alloc", "vitest.alloc.config.ts"],
  "exclude": [
    "tests/error-policy.test.ts",
    "tests/storage-models.test.ts",
    "tests/integration-wasm/determinism.test.ts",
    "tests/integration-wasm/netcode-ready.test.ts",
    "tests/integration-wasm/p1-error-policy.test.ts",
    "tests/integration-wasm/p1-memory-growth.test.ts",
    "tests/integration-wasm/p54-stale-physics-handles.test.ts",
    "tests/integration-wasm/wasm-errors.test.ts",
    "tests/integration-wasm/wasm-export-inventory.test.ts"
  ]
}
