{
  "name": "@gwenjs/core",
  "version": "0.2.2",
  "description": "GWEN Core Engine - ECS + WASM",
  "license": "MPL-2.0",
  "files": [
    "dist",
    "wasm",
    "!wasm/toolchain.json",
    "LICENSE",
    "THIRD-PARTY-NOTICES"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./system": {
      "types": "./dist/system/index.d.ts",
      "import": "./dist/system/index.js"
    },
    "./actor": {
      "types": "./dist/actor/index.d.ts",
      "import": "./dist/actor/index.js"
    },
    "./scene": {
      "types": "./dist/scene/index.d.ts",
      "import": "./dist/scene/index.js"
    },
    "./tween": {
      "types": "./dist/tween/index.d.ts",
      "import": "./dist/tween/index.js"
    },
    "./system/module": {
      "types": "./dist/system/module.d.ts",
      "import": "./dist/system/module.js"
    },
    "./actor/module": {
      "types": "./dist/actor/module.d.ts",
      "import": "./dist/actor/module.js"
    },
    "./scene/module": {
      "types": "./dist/scene/module.d.ts",
      "import": "./dist/scene/module.js"
    },
    "./router/module": {
      "types": "./dist/router/module.d.ts",
      "import": "./dist/router/module.js"
    },
    "./tween/module": {
      "types": "./dist/tween/module.d.ts",
      "import": "./dist/tween/module.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    },
    "./wasm/light": {
      "types": "./wasm/light/gwen_core.d.ts",
      "import": "./wasm/light/gwen_core.js"
    },
    "./wasm/light/factory": {
      "types": "./wasm/light/gwen_core_factory.d.ts",
      "import": "./wasm/light/gwen_core_factory.js"
    },
    "./wasm/physics2d": {
      "types": "./wasm/physics2d/gwen_core.d.ts",
      "import": "./wasm/physics2d/gwen_core.js"
    },
    "./wasm/physics2d/factory": {
      "types": "./wasm/physics2d/gwen_core_factory.d.ts",
      "import": "./wasm/physics2d/gwen_core_factory.js"
    },
    "./wasm/physics3d": {
      "types": "./wasm/physics3d/gwen_core.d.ts",
      "import": "./wasm/physics3d/gwen_core.js"
    },
    "./wasm/physics3d/factory": {
      "types": "./wasm/physics3d/gwen_core_factory.d.ts",
      "import": "./wasm/physics3d/gwen_core_factory.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node ../../scripts/fix-dts-extensions.mjs .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:wasm": "vitest run --config vitest.wasm.config.ts",
    "test:browser": "node tests/browser/build-site.mjs && playwright test",
    "test:alloc": "vitest run --config vitest.alloc.config.ts",
    "bench": "vitest bench --run",
    "bench:ecs": "vitest bench --run bench/ecs.bench.ts",
    "bench:query": "vitest bench --run bench/query.bench.ts",
    "bench:simulation": "vitest bench --run bench/simulation.bench.ts",
    "bench:simulation-wasm": "vitest bench --run bench/simulation-wasm.bench.ts",
    "bench:ci": "vitest bench --run",
    "watch": "vite build --watch"
  },
  "dependencies": {
    "@gwenjs/kit": "workspace:^",
    "@gwenjs/math": "workspace:^",
    "@gwenjs/schema": "workspace:^",
    "hookable": "^6.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^25.6.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.2"
  }
}
