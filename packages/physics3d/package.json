{
  "name": "@gwenjs/physics3d",
  "version": "0.2.1",
  "description": "3D physics plugin foundation for GWEN — Rapier3D adapter surface",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./module": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "postbuild": "node ../../scripts/fix-dts-extensions.mjs .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@gwenjs/core": "workspace:^",
    "@gwenjs/kit": "workspace:^",
    "@gwenjs/schema": "workspace:^",
    "@gwenjs/vite": "workspace:^"
  },
  "devDependencies": {
    "hookable": "^6.0.1",
    "magic-string": "^0.30.21",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.2"
  }
}
