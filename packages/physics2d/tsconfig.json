{
  "compilerOptions": {
    "composite": true,
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": true,
    "rootDir": "src",
    "sourceMap": true,
    "outDir": "./dist",
    "types": ["node"]
  },
  "include": ["src"],
  "extends": "../../tsconfig.base.json",
  "references": [
    {
      "path": "../core"
    },
    {
      "path": "../kit"
    },
    {
      "path": "../math"
    }
  ]
}
