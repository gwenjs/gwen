{
  "name": "@gwenjs/app",
  "version": "0.3.0",
  "license": "MPL-2.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./resolve": {
      "types": {
        "import": "./dist/resolve.d.ts",
        "require": "./dist/resolve.d.cts"
      },
      "import": "./dist/resolve.js",
      "require": "./dist/resolve.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && cp dist/index.d.ts dist/index.d.cts && cp dist/resolve.d.ts dist/resolve.d.cts",
    "postbuild": "node ../../scripts/fix-dts-extensions.mjs .",
    "dev": "vite build --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gwenjs/core": "workspace:*",
    "@gwenjs/kit": "workspace:*",
    "@gwenjs/renderer-core": "workspace:*",
    "c12": "4.0.0-beta.3",
    "defu": "^6.1.4",
    "hookable": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.2"
  }
}
