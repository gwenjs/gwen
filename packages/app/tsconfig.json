{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": "../..",
    "outDir": "dist",
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.tsbuildinfo",
    "types": ["node"],
    "skipLibCheck": true,
    "customConditions": ["development"]
  },
  "include": ["src", "tests"],
  "references": [
    {
      "path": "../core"
    },
    {
      "path": "../kit"
    },
    {
      "path": "../renderer-core"
    },
    {
      "path": "../schema"
    }
  ]
}
