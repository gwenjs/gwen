{
  "name": "@gwenjs/vite",
  "version": "0.2.0",
  "description": "Vite plugin for GWEN — WASM hot-reload, asset copying, manifest injection",
  "license": "MPL-2.0",
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./shared/layer-utils": {
      "types": "./dist/shared/layer-utils.d.ts",
      "import": "./dist/shared/layer-utils.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "postbuild": "node ../../scripts/fix-dts-extensions.mjs .",
    "dev": "vite build --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gwenjs/app": "workspace:*",
    "@gwenjs/kit": "workspace:*",
    "magic-string": "^0.30.21",
    "oxc-parser": "^0.123.0",
    "oxc-walker": "^0.7.0",
    "unctx": "^2.5.0",
    "unimport": "^6.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.2"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  }
}
