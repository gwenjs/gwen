{
  "name": "@gwenjs/physics-core",
  "version": "0.1.0",
  "description": "Shared physics types, layers and collision events for GWEN",
  "license": "MPL-2.0",
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./module": {
      "types": "./dist/module/index.d.ts",
      "import": "./dist/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "postbuild": "node ../../scripts/fix-dts-extensions.mjs .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@gwenjs/core": "workspace:^",
    "@gwenjs/kit": "workspace:^",
    "@gwenjs/math": "workspace:^",
    "@gwenjs/schema": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^20.19.37",
    "@vitest/coverage-v8": "^4.1.2",
    "magic-string": "^0.30.21",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.2"
  }
}
